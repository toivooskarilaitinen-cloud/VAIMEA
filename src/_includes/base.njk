<!doctype html>
<html lang="fi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="description" content="{{ description or site.description }}">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="alternate" type="application/rss+xml" title="VAIMEA RSS" href="/feed.xml">
</head>
<body>
  <div class="shell">
    <header class="site-header">
      <div class="identity">
        <a class="wordmark" href="/manifesti/" aria-label="VAIMEA — manifesti">VAIMEA</a>
        <span class="tagline">riippumaton verkkojulkaisu</span>
      </div>
      <nav aria-label="Päänavigaatio">
        <a href="/">[ UUSIMMAT ]</a>
        <a href="/arkisto/">[ ARKISTO ]</a>
        <a href="/feed.xml">[ RSS ]</a>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <span>VAIMEA/</span>
      <span>tapa nähdä maailma</span>
    </footer>
  </div>
</body>
</html>
